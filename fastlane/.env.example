# Copy this file to fastlane/.env and fill in your real values.
# fastlane/.env is git-ignored — never commit it.
#
# Get these from App Store Connect → Users and Access → Integrations →
# App Store Connect API → generate a key with "App Manager" access.

# The Key ID shown next to the generated key (e.g. ABC123XYZ9)
ASC_KEY_ID=

# The Issuer ID at the top of the API Keys page (a UUID)
ASC_ISSUER_ID=

# Absolute path to the downloaded .p8 private key file.
# You can only download it ONCE — store it outside the repo.
# e.g. /Users/nhat/secrets/AuthKey_ABC123XYZ9.p8
ASC_KEY_PATH=
